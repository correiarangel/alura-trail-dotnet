# .gitignore para projetos C# / .NET
# Gerado para ignorar artefatos de build, IDEs e arquivos sensíveis

# Visual Studio
.vs/
.vscode/

# Rider
.idea/

# Build outputs
bin/
obj/
**/bin/
**/obj/

# Configuration and user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
packages/
*.nupkg
project.assets.json
project.lock.json
project.fragment.lock.json
artifacts/

# Publish
publish/
out/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE / Tools
*.vsix
*.db

# Docs (incluir pasta Docs solicitada)
Docs/
docs/

# Ignore built files generated by dotnet tools
*.dotCover

# Optional: lock files, generated files
*.g.dart

# End of file
