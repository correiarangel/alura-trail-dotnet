@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-4">

    <div class="row mb-4">
        <div class="col">
            <h1 class="fw-bold">FileManage</h1>
            <p class="text-muted">
                Gerenciador de arquivos JSON em Blazor WebAssembly (PWA)
            </p>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Gerar JSON</h5>
                    <p class="card-text">
                        Crie arquivos JSON contendo uma pessoa ou uma lista de pessoas.
                    </p>
                    <ul class="mb-0">
                        <li>Pessoa única</li>
                        <li>Lista de pessoas</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Ler JSON</h5>
                    <p class="card-text">
                        Importe arquivos JSON do seu computador e visualize os dados.
                    </p>
                    <ul class="mb-0">
                        <li>Ler pessoa</li>
                        <li>Ler lista de pessoas</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Consulta</h5>
                    <p class="card-text">
                        Trabalhe com os dados carregados.
                    </p>
                    <ul class="mb-0">
                        <li>Listagem</li>
                        <li>Filtro por idade</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-5">
        <div class="col">
            <div class="alert alert-secondary">
                Use o menu lateral para navegar entre as funcionalidades.
            </div>
        </div>
    </div>

</div>
