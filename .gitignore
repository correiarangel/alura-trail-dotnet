# .gitignore para projetos C# / .NET

# Visual Studio
.vs/
.vscode/

# Rider
.idea/

# Build outputs
bin/
obj/
**/bin/
**/obj/

# Configuration and user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
packages/
*.nupkg
project.assets.json
project.lock.json
project.fragment.lock.json
artifacts/

# Publish
publish/
out/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE / Tools
*.vsix
*.db

# Docs
Docs/
docs/

# dotnet tools
*.dotCover

# Lock/generated files
*.g.dart

# Projetos independentes com repositório próprio (não rastreados pelo repo pai)
ApiNet/ScreenSound-Curso4.worktrees/

# -------------------------------------------------------
# SEGURANÇA — arquivos que NUNCA devem ir para o repositório
# -------------------------------------------------------

# .NET User Secrets (gerado por `dotnet user-secrets`)
**/Properties/launchSettings.json
secrets.json
**/secrets.json

# Arquivos de ambiente com credenciais reais
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Certificados e chaves privadas
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt

# appsettings com credenciais reais — use variáveis de ambiente ou User Secrets em vez disso
# (os arquivos de exemplo sem senha real podem ser commitados com sufixo .example)
appsettings.Development.json
appsettings.Staging.json
appsettings.Production.json
appsettings.Prod.json

# Arquivos de credenciais de ferramentas diversas
**/google-credentials.json
**/firebase-adminsdk*.json
**/service-account*.json
**/gcloud-credentials.json
terraform.tfvars
*.tfvars

# End of file
